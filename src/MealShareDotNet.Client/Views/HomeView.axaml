<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MealShareDotNet.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MealShareDotNet.Client.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel VerticalAlignment="Stretch">
    <Border Background="LightGray" MaxWidth="200" DockPanel.Dock="Right">
      <StackPanel Orientation="Vertical">
        <TextBlock Text="Recipe of the Day" />
        <TextBlock Text="{Binding DailyRecipe.Name}" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Vertical">
      <TextBlock Text="MealShare.NET" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </StackPanel>
  </DockPanel>
</UserControl>
